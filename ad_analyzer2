@app.route("/", methods=["GET", "POST"])
def home():
    if request.method == "POST":
        try:
            # Get form data
            ad_type = int(request.form.get("ad_type", 1))
            color = int(request.form.get("color", 6))
            audience = int(request.form.get("audience", 3))
            platform = int(request.form.get("platform", 1))
            day = int(request.form.get("day", 3))
            posting_hour = int(request.form.get("time", 18))
            
            # Prepare ML features
            headline_length = 10
            features = np.array([[headline_length, ad_type, color, audience, platform, posting_hour, day]])
            features_scaled = scaler.transform(features)
            
            # Get ML score
            ml_base_score = float(ml_model.predict(features_scaled)[0])
            ml_base_score = min(100, max(10, ml_base_score + random.randint(-5, 5)))
            
            vlm_score = None
            recommendations = []
            insights = []
            
            # Process image if uploaded
            if 'ad_image' in request.files and request.files['ad_image'].filename != '':
                file = request.files['ad_image']
                
                if not allowed_file(file.filename):
                    return jsonify({"error": "Invalid file format. Use PNG, JPG, JPEG, or WEBP"}), 400
                
                print(f"\n🚀 Processing image: {file.filename}")
                
                # Run full analysis pipeline
                analysis = analyze_image(file)
                
                if analysis['success']:
                    vlm_score = int(analysis['score'])
                    recommendations = analysis['recommendations'][:5]
                    
                    insights = [
                        f"🤖 AI Caption: \"{analysis['pipeline']['vlm_caption']}\"",
                        f"🎨 Color Palette: {analysis['detailed_insights']['color_family']}",
                        f"📊 Sentiment: {analysis['detailed_insights']['sentiment']}",
                        f"🔍 Composition: {analysis['detailed_insights']['composition_quality']}",
                    ]
                    
                    # Hybrid score (60% ML + 40% VLM)
                    final_score = int(0.6 * ml_base_score + 0.4 * vlm_score)
                else:
                    insights.append(f"⚠️ Image processing error: {analysis.get('error', 'Unknown error')}")
                    final_score = int(ml_base_score)
            else:
                final_score = int(ml_base_score)
            
            # Ensure score bounds
            final_score = min(100, max(0, final_score))
            
            # Color mapping for feedback
            if final_score >= 80:
                feedback = "🔥 Excellent Ad Potential"
                color_hex = "#ccff00"
                color_glow = "rgba(204, 255, 0, 0.5)"
            elif final_score >= 60:
                feedback = "👍 Good, But Could Improve"
                color_hex = "#facc15"
                color_glow = "rgba(250, 204, 21, 0.5)"
            else:
                feedback = "⚠️ Needs Optimization"
                color_hex = "#f87171"
                color_glow = "rgba(248, 113, 113, 0.5)"
            
            return render_template_string(
                HTML_TEMPLATE,
                score=final_score,
                feedback=feedback,
                color_hex=color_hex,
                color_glow=color_glow,
                suggestions=recommendations,
                insights=insights,
                ml_score=int(ml_base_score),
                vlm_score=vlm_score,
                ad_type=ad_type,
                color=color,
                audience=audience,
                platform=platform,
                day=day
            )
        
        except Exception as e:
            print(f"❌ Route error: {e}")
            return jsonify({"error": str(e)}), 500
    
    return render_template_string(HTML_TEMPLATE)

