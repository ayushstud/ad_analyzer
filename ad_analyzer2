                    <option value="1">📱 Poster</option>
                    <option value="2">📱 Social Ad</option>
                    <option value="3">📐 Banner</option>
                </select>
            </div>

            <div class="form-group">
                <label>Upload Ad Image</label>
                <div class="upload-area" id="dropZone">
                    <input type="file" id="imageInput" name="ad_image" accept="image/png, image/jpeg, image/webp" required>
                    <div class="upload-icon">⬆️</div>
                    <div class="upload-title">Drop your ad here</div>
                    <div class="upload-subtitle">PNG, JPG, WEBP (max 16MB)</div>
                    <img id="imagePreview" src="" alt="Preview">
                </div>
            </div>

            <div class="metrics-grid" style="display: grid; grid-template-columns: 1fr 1fr 1fr;">
                <div class="form-group">
                    <label>Target Audience</label>
                    <select name="audience">
                        <option value="1">👨‍🎓 Students</option>
                        <option value="2">💼 Professionals</option>
                        <option value="3" selected>🌍 General</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Platform</label>
                    <select name="platform">
                        <option value="1" selected>📱 Instagram</option>
                        <option value="2">🎬 YouTube</option>
                        <option value="3">👥 Facebook</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Posting Hour (0-23)</label>
                    <input type="number" name="time" min="0" max="23" value="18">
                </div>
            </div>

            <button type="submit" class="btn-submit">🔬 Analyze Now</button>
        </form>
    </div>

    {% if score is defined %}
    <div class="results-wrapper" id="results">
        <h2 style="text-align: center; margin-bottom: 2rem; font-size: 2rem; font-weight: 800;">✨ Analysis Results</h2>

        <div class="score-container" style="--score-degrees: {{ score * 3.6 }}deg; --score-color: {{ color_hex }}; --score-glow: {{ color_glow }};">
            <div class="score-circle">
                <span class="score-value">{{ score }}</span>
            </div>
            <div class="feedback" style="color: {{ color_hex }}; border-color: {{ color_hex }};">
                {{ feedback }}
            </div>
        </div>

        {% if vlm_score is defined and vlm_score %}
        <div class="metrics-grid">
            <div class="metric-card" style="text-align: center;">
                <h3>🤖 ML Score</h3>
                <div style="font-size: 3rem; font-weight: 800; color: var(--accent-primary);">{{ ml_score }}</div>
            </div>
            <div class="metric-card" style="text-align: center;">
                <h3>👁️ Vision Score</h3>
                <div style="font-size: 3rem; font-weight: 800; color: var(--accent-primary);">{{ vlm_score }}</div>
            </div>
        </div>
        {% endif %}

        <div class="metric-card">
            <h3>💡 Recommendations</h3>
            {% for suggestion in suggestions %}
            <div class="insight-item">{{ suggestion }}</div>
            {% endfor %}
        </div>

        <div class="metric-card">
            <h3>🔍 Key Insights</h3>
            {% for insight in insights %}
            <div class="insight-item">{{ insight }}</div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>

<script>
    document.getElementById('imageInput').addEventListener('change', function(e) {
        const reader = new FileReader();
        reader.onload = function() {
            document.getElementById('imagePreview').src = reader.result;
            document.getElementById('imagePreview').style.display = 'block';
        };
        if(e.target.files[0]) reader.readAsDataURL(e.target.files[0]);
    });

    {% if score is defined %}
    window.onload = function() {
        setTimeout(() => {
            document.getElementById('results').scrollIntoView({ behavior: 'smooth' });
        }, 100);
    };
    {% endif %}
</script>

</body>
</html>
