def allowed_file(filename):
    """Validate file extension"""
    return '.' in filename and filename.rsplit('.', 1)[1].lower() in ALLOWED_EXTENSIONS

def extract_text_ocr(image):
    """Extract text from image using Tesseract OCR"""
    try:
        text = pytesseract.image_to_string(image)
        return text.strip() if text else ""
    except Exception as e:
        print(f"⚠️ OCR Error: {e}")
        return ""

def analyze_sentiment_nlp(text):
    """Analyze sentiment of extracted text"""
    if not text:
        return {
            "polarity": 0.5,  # neutral
            "subjectivity": 0.5,
            "sentiment": "neutral",
            "keywords": []
        }
    
    try:
        blob = TextBlob(text)
        polarity = (blob.sentiment.polarity + 1) / 2  # Scale to 0-1
        subjectivity = blob.sentiment.subjectivity
        
        # Simple sentiment classification
        if polarity > 0.6:
            sentiment = "positive"
        elif polarity < 0.4:
            sentiment = "negative"
        else:
            sentiment = "neutral"
        
        # Extract keywords (simplified)
        words = blob.words
        keywords = [word.lower() for word in words if len(word) > 4]
        
        return {
            "polarity": round(polarity, 2),
            "subjectivity": round(subjectivity, 2),
            "sentiment": sentiment,
            "keywords": list(set(keywords))[:5],
            "text_length": len(text),
            "word_count": len(words)
        }
    except Exception as e:
        print(f"⚠️ NLP Error: {e}")
        return {
            "polarity": 0.5,
            "subjectivity": 0.5,
            "sentiment": "unknown",
            "keywords": [],
            "text_length": len(text) if text else 0,
            "word_count": len(text.split()) if text else 0
        }

def analyze_colors_cv(image):
    """Analyze color distribution and contrast using Computer Vision"""
    try:
        # Convert to RGB if needed
        img_rgb = image.convert('RGB')
        
        # Grayscale for brightness/contrast analysis
        img_gray = image.convert('L')
        stat = ImageStat.Stat(img_gray)
        
        brightness = float(stat.mean[0]) if stat.mean else 128.0
        contrast = float(stat.stddev[0]) if stat.stddev else 0.0
        
        # Analyze color distribution
        pixels = np.array(img_rgb)
        avg_r = float(np.mean(pixels[:, :, 0]))
        avg_g = float(np.mean(pixels[:, :, 1]))
        avg_b = float(np.mean(pixels[:, :, 2]))
        
        # Color vibrancy (saturation)
        hsv = img_rgb.convert('HSV')
        hsv_pixels = np.array(hsv)
        avg_saturation = float(np.mean(hsv_pixels[:, :, 1]))
        
        # Dominant color family
        if avg_r > avg_g and avg_r > avg_b:
            color_family = "Warm (Red/Orange)"
        elif avg_g > avg_r and avg_g > avg_b:
            color_family = "Cool (Green)"
        elif avg_b > avg_r and avg_b > avg_g:
            color_family = "Cool (Blue)"
        else:
            color_family = "Neutral (Gray)"
        
        return {
            "brightness": round(brightness, 2),
            "contrast": round(contrast, 2),
            "avg_r": round(avg_r, 2),
            "avg_g": round(avg_g, 2),
            "avg_b": round(avg_b, 2),
            "saturation": round(avg_saturation, 2),
            "color_family": color_family,
            "brightness_score": min(10, max(1, int((brightness / 25.5)))),
            "contrast_score": min(10, max(1, int((contrast / 12.8))))
        }
    except Exception as e:
        print(f"⚠️ Color Analysis Error: {e}")
        return {
            "brightness": 128.0,
            "contrast": 0.0,
            "avg_r": 128.0,
            "avg_g": 128.0,
            "avg_b": 128.0,
            "saturation": 0.5,
            "color_family": "Unknown",
            "brightness_score": 5,
            "contrast_score": 5
        }

def analyze_layout_cv(image):
    """Analyze image layout and composition"""
    try:
        width, height = image.size
        aspect_ratio = width / height if height > 0 else 1.0
        
        # Detect edges for composition analysis
        edges = image.filter(ImageFilter.FIND_EDGES)
        edge_pixels = np.array(edges)
        edge_density = float(np.mean(edge_pixels)) / 255.0
        
        return {
            "width": width,
            "height": height,
            "aspect_ratio": round(aspect_ratio, 2),
            "is_portrait": height > width,
            "is_landscape": width > height,
            "edge_density": round(edge_density, 2),
            "composition_score": min(10, max(1, int(edge_density * 10)))
        }
    except Exception as e:
        print(f"⚠️ Layout Analysis Error: {e}")
        return {
            "width": 0,
            "height": 0,
            "aspect_ratio": 1.0,
            "is_portrait": False,
            "is_landscape": False,
            "edge_density": 0.5,
            "composition_score": 5
        }

def analyze_image_with_vlm(image):
    """Generate caption using Vision Language Model"""
    try:
        if blip_model is None:
            return "Ad content detected"
        
        inputs = processor(images=image, return_tensors="pt").to(device)
        with torch.no_grad():
            out = blip_model.generate(**inputs, max_length=100)
        caption = processor.decode(out[0], skip_special_tokens=True)
        return caption
    except Exception as e:
        print(f"⚠️ VLM Error: {e}")
        return "Unable to generate caption"

def calculate_final_score(features):
    """Calculate final ad score from all features"""
    try:
        # Extract scores
        brightness_score = features['color_analysis']['brightness_score']
        contrast_score = features['color_analysis']['contrast_score']
        composition_score = features['layout_analysis']['composition_score']
        nlp_polarity = features['nlp_analysis']['polarity'] * 10
        saturation = min(10, features['color_analysis']['saturation'])
        
        # Weighted combination
        weights = {
            'brightness': 0.15,
            'contrast': 0.20,
            'composition': 0.20,
            'sentiment': 0.20,
            'saturation': 0.15,
            'text_quality': 0.10
        }
        
        text_quality = min(10, max(1, features['nlp_analysis']['word_count'] / 5))
        
        final_score = (
            brightness_score * weights['brightness'] +
            contrast_score * weights['contrast'] +
            composition_score * weights['composition'] +
            nlp_polarity * weights['sentiment'] +
            saturation * weights['saturation'] +
            text_quality * weights['text_quality']
        )
        
        return round(min(100, max(10, final_score)), 1)
    except Exception as e:
        print(f"⚠️ Scoring Error: {e}")
        return 50.0

def generate_recommendations(features, score):
    """Generate actionable recommendations"""
    recommendations = []
    
    # Brightness recommendations
    if features['color_analysis']['brightness_score'] < 4:
        recommendations.append("🔆 Increase brightness - image is too dark for ad visibility")
    elif features['color_analysis']['brightness_score'] > 9:
        recommendations.append("🔅 Reduce brightness - image might be too washed out")
    
    # Contrast recommendations
    if features['color_analysis']['contrast_score'] < 3:
        recommendations.append("⚡ Improve contrast - make elements pop with more definition")
    
    # Layout recommendations
    if features['layout_analysis']['edge_density'] < 0.2:
        recommendations.append("📐 Simplify composition - add more visual elements or focal points")
    
    # Text recommendations
    text_length = features['nlp_analysis']['text_length']
    if text_length > 500:
        recommendations.append("📝 Reduce text - aim for <200 characters for maximum impact")
    elif text_length < 20 and text_length > 0:
        recommendations.append("📝 Add more descriptive text - current copy is too brief")
    
    # Sentiment recommendations
    if features['nlp_analysis']['sentiment'] == 'negative':
        recommendations.append("😊 Use positive language - negative sentiment may deter engagement")
    
    # Saturation recommendations
    if features['color_analysis']['saturation'] < 0.3:
        recommendations.append("🎨 Increase color vibrancy - muted colors reduce visual impact")
    
    return recommendations if recommendations else ["✅ Great ad - minimal improvements needed"]

def analyze_image(image_file):
    """Main image analysis pipeline"""
    try:
        # Open image
        if isinstance(image_file, str):
            image = Image.open(image_file).convert('RGB')
        else:
            image = image_file.convert('RGB')
        
        print("📸 Image loaded, starting analysis pipeline...")
        
        # ===== PIPELINE EXECUTION =====
        
        # 1. OCR - Extract Text
        print("1️⃣ Extracting text with OCR...")
        extracted_text = extract_text_ocr(image)
        
        # 2. NLP - Analyze Text
        print("2️⃣ Analyzing text with NLP...")
        nlp_results = analyze_sentiment_nlp(extracted_text)
        
        # 3. CV - Color Analysis
        print("3️⃣ Analyzing colors with CV...")
        color_results = analyze_colors_cv(image)
        
        # 4. CV - Layout Analysis
        print("4️⃣ Analyzing layout with CV...")
        layout_results = analyze_layout_cv(image)
        
        # 5. VLM - Generate Caption
        print("5️⃣ Generating caption with Vision Language Model...")
        caption = analyze_image_with_vlm(image)
        
        # Combine all features
        features = {
            "ocr_text": extracted_text,
            "nlp_analysis": nlp_results,
            "color_analysis": color_results,
            "layout_analysis": layout_results,
            "vlm_caption": caption
        }
        
        # 6. Scoring Algorithm
        print("6️⃣ Calculating score...")
        final_score = calculate_final_score(features)
        
        # 7. Recommendation Engine
        print("7️⃣ Generating recommendations...")
        recommendations = generate_recommendations(features, final_score)
        
        # 8. Format Output
        print("8️⃣ Formatting output...")
        result = {
            "success": True,
            "score": final_score,
            "pipeline": {
                "ocr": {"text_detected": len(extracted_text) > 0, "char_count": len(extracted_text)},
                "nlp": nlp_results,
                "cv_color": {k: v for k, v in color_results.items() if isinstance(v, (int, float, str))},
                "cv_layout": layout_results,
                "vlm_caption": caption
            },
            "recommendations": recommendations,
            "detailed_insights": {
                "sentiment": nlp_results['sentiment'].upper(),
                "color_family": color_results['color_family'],
                "composition_quality": "Good" if layout_results['edge_density'] > 0.3 else "Needs Work",
                "text_quality": "Descriptive" if nlp_results['word_count'] > 10 else "Brief"
            }
        }
        
        return result
        
    except Exception as e:
        print(f"❌ Error in analyze_image: {e}")
        return {
            "success": False,
            "error": str(e),
            "score": 50,
            "pipeline": {},
            "recommendations": ["Error processing image - please try again"],
            "detailed_insights": {}
        }

