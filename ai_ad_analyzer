# ---------------------------
# LOAD BLIP MODEL
# ---------------------------
# Load model slowly on first run
device = "cuda" if torch.cuda.is_available() else "cpu"
processor = BlipProcessor.from_pretrained("Salesforce/blip-image-captioning-base")
blip_model = BlipForConditionalGeneration.from_pretrained("Salesforce/blip-image-captioning-base").to(device)

def analyze_image(image_file):
    image = Image.open(image_file).convert('RGB')
    
    # Calculate visual properties via PIL
    stat = ImageStat.Stat(image.convert("L"))
    brightness = stat.mean[0]
    contrast = stat.stddev[0]
    
    color_score = min(10, max(1, int((brightness / 255) * 10)))
    visual_clarity_score = min(10, max(1, int((contrast / 128) * 10)))
    
    # Generate caption using BLIP
    inputs = processor(images=image, return_tensors="pt").to(device)
    out = blip_model.generate(**inputs)
    caption = processor.decode(out[0], skip_special_tokens=True)
    
    # Extract heuristics based on VLM
    caption_lower = caption.lower()
    text_density_score = 5
    if any(word in caption_lower for word in ['text', 'sign', 'writing', 'words', 'poster', 'logo']):
        text_density_score = 8
        
    emotional_impact_score = 6
    if any(word in caption_lower for word in ['smile', 'happy', 'laugh', 'people', 'person', 'exciting', 'bright', 'vibrant']):
        emotional_impact_score = 9
    elif any(word in caption_lower for word in ['dark', 'empty', 'boring', 'bland']):
        emotional_impact_score = 3
        
    return {
        "caption": caption,
        "color_score": color_score,
        "visual_clarity_score": visual_clarity_score,
        "text_density_score": text_density_score,
        "emotional_impact_score": emotional_impact_score
    }

# ---------------------------
# TRAIN SIMPLE MODEL
# ---------------------------
# Features:
# [headline_length, ad_type, color_score, audience, platform, posting_hour, posting_day]
X = np.array([
    [5, 1, 8, 1, 1, 20, 1],
    [10, 2, 7, 2, 2, 21, 3],
    [20, 3, 3, 3, 3, 10, 6],
    [8, 1, 9, 1, 1, 19, 5],
    [15, 2, 5, 2, 2, 14, 2],
    [7, 3, 8, 3, 3, 20, 7],
    [25, 1, 2, 1, 1, 9, 4],
    [9, 2, 7, 2, 2, 18, 5],
    [12, 1, 9, 3, 1, 19, 7]
])

y = np.array([78, 85, 35, 92, 50, 88, 25, 80, 95])

model = RandomForestRegressor(n_estimators=50, random_state=42)
model.fit(X, y)

